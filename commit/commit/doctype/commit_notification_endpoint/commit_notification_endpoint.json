  {"fieldname": "events", "fieldtype": "Small Text", "label": "Events", "description": "Comma-separated: scan.completed, scan.failed, finding.critical, docs.stale"},
  {"fieldname": "webhook_url", "fieldtype": "Data", "label": "Webhook URL", "options": "URL"},
  {"fieldname": "email_recipients", "fieldtype": "Small Text", "label": "Email Recipients"},
  {"fieldname": "secret", "fieldtype": "Password", "label": "Signing Secret"},
  {"default": "1", "fieldname": "enabled", "fieldtype": "Check", "label": "Enabled"}
 ],
 "permissions": [{"role": "System Manager", "read": 1, "report": 1, "create": 1, "write": 1, "delete": 1}, {"role": "Commit Project Member", "read": 1, "create": 1, "write": 1, "delete": 1}],
 "sort_field": "modified", "sort_order": "DESC"
}
